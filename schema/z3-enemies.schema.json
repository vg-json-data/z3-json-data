{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "z3-enemies.schema.json",
  "type": "object",
  "description": "Enemies, bosses, hazards, and attacks in Link to the Past.",
  "required": [
    "enemies"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "enemies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "names",
          "dmgToLink",
          "spriteIndex"
        ],
        "additionalProperties": false,
        "properties": {
          "names": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "attacks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "hp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "dmgToLink": {
            "type": "object",
            "required": [
              "green",
              "blue",
              "red"
            ],
            "additionalProperties": false,
            "properties": {
              "green": {
                "type": "integer",
                "minimum": 0
              },
              "blue": {
                "type": "integer",
                "minimum": 0
              },
              "red": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "dmgFromLink": {
            "type": "object",
            "required": [
              "boomerang",
              "class1",
              "class2",
              "class3",
              "class4",
              "class5",
              "arrows",
              "hookshot",
              "bombs",
              "silverArrows",
              "magicPowder",
              "fireRod",
              "iceRod",
              "bombos",
              "ether",
              "quake"
            ],
            "additionalProperties": false,
            "properties": {
              "boomerang": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "enum": [
                      "stun1Second",
                      "stun4Seconds",
                      "stun10Seconds"
                    ]
                  }
                ]
              },
              "class1": {
                "type": "integer",
                "minimum": 0
              },
              "class2": {
                "type": "integer",
                "minimum": 0
              },
              "class3": {
                "type": "integer",
                "minimum": 0
              },
              "class4": {
                "type": "integer",
                "minimum": 0
              },
              "class5": {
                "type": "integer",
                "minimum": 0
              },
              "arrows": {
                "type": "integer",
                "minimum": 0
              },
              "hookshot": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "const": "stun10Seconds"
                  }
                ]
              },
              "bombs": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "const": "stun10Seconds"
                  }
                ]
              },
              "silverArrows": {
                "type": "integer",
                "minimum": 0
              },
              "magicPowder": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "enum": [
                      "fairy",
                      "slime"
                    ]
                  }
                ]
              },
              "fireRod": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "const": "incinerate"
                  }
                ]
              },
              "iceRod": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "const": "freeze"
                  }
                ]
              },
              "bombos": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "const": "incinerate"
                  }
                ]
              },
              "ether": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "const": "freeze"
                  }
                ]
              },
              "quake": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "enum": [
                      "stun10Seconds",
                      "slime"
                    ]
                  }
                ]
              }
            }
          },
          "spriteIndex": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 255
          },
          "additionalSpriteIndex": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "spawnsSprite": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "prizePack": {
            "enum": [
              0,
              1,
              2,
              3,
              4,
              5,
              6,
              null
            ]
          },
          "note": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "devNote": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
