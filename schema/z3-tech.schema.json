{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "z3-tech.schema.json",
  "type": "object",
  "description": "Techniques and proficiency tiers used by Link to the Past logic.",
  "required": [
    "techCategories"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "techCategories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "techs"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "techs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "tiers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "value",
                      "note"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "value": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "note": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "techRequires": {
                  "type": "array",
                  "items": {
                    "$ref": "z3-requirement.schema.json"
                  }
                },
                "otherRequires": {
                  "type": "array",
                  "items": {
                    "$ref": "z3-requirement.schema.json"
                  }
                },
                "note": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "devNote": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "extensionTechs": {
                  "type": "array",
                  "minItems": 1,
                  "description": "More complex forms of this tech whose requirements stand alone.",
                  "items": {
                    "$ref": "#/properties/techCategories/items/properties/techs/items"
                  }
                }
              },
              "oneOf": [
                {
                  "required": [
                    "tiers"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "techRequires"
                        ]
                      },
                      {
                        "required": [
                          "otherRequires"
                        ]
                      }
                    ]
                  }
                },
                {
                  "required": [
                    "techRequires",
                    "otherRequires"
                  ],
                  "not": {
                    "required": [
                      "tiers"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
