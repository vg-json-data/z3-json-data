{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "z3-requirement.schema.json",
  "description": "A single logical condition used in a requirements list. A string names a base requirement such as an item, flag, tech, or helper.",
  "type": [
    "string",
    "object"
  ],
  "minProperties": 1,
  "maxProperties": 1,
  "additionalProperties": false,
  "properties": {
    "and": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#"
      }
    },
    "or": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#"
      }
    },
    "not": {
      "type": "string"
    },
    "sword": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "swordExact": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "shield": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "shieldExact": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "glove": {
      "type": "integer",
      "enum": [
        0,
        1,
        2
      ]
    },
    "arrows": {
      "type": "integer",
      "minimum": 1
    },
    "silverArrows": {
      "type": "integer",
      "minimum": 1
    },
    "bombs": {
      "type": "integer",
      "minimum": 1
    },
    "magicPowder": {
      "type": "integer",
      "minimum": 1
    },
    "fireRod": {
      "type": "integer",
      "minimum": 1
    },
    "iceRod": {
      "type": "integer",
      "minimum": 1
    },
    "rod": {
      "type": "integer",
      "minimum": 1
    },
    "bombos": {
      "type": "integer",
      "minimum": 1
    },
    "ether": {
      "type": "integer",
      "minimum": 1
    },
    "quake": {
      "type": "integer",
      "minimum": 1
    },
    "lamp": {
      "type": "integer",
      "minimum": 1
    },
    "redCane": {
      "type": "integer",
      "minimum": 1
    },
    "blueCane": {
      "type": "integer",
      "minimum": 1
    },
    "cape": {
      "type": "integer",
      "minimum": 1
    },
    "damage": {
      "type": "object",
      "required": [
        "enemy",
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "enemy": {
          "type": "string"
        },
        "attack": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "refill": {
      "type": "object",
      "required": [
        "type",
        "limit"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "combatProficiency": {
      "type": "integer",
      "minimum": 1
    },
    "bossProficiency": {
      "type": "integer",
      "minimum": 1
    },
    "darkProficiency": {
      "type": "integer",
      "minimum": 1
    },
    "unlockDoor": {
      "type": "integer",
      "minimum": 1
    },
    "pay": {
      "type": "integer",
      "minimum": 1
    },
    "flag": {
      "type": "string"
    },
    "notFlag": {
      "type": "string"
    },
    "obstaclesCleared": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "resourceMissingAtMost": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
