{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "z3-room.schema.json",
  "type": "object",
  "description": "A contiguous area in Link to the Past.",
  "required": ["id", "name", "roomType", "nodes", "strats", "nextStratId"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "type": "string",
      "description": "The room's name; for overworld rooms, the Light World name."
    },
    "darkWorldName": {
      "type": "string",
      "minLength": 1,
      "description": "The Dark World name of an overworld room."
    },
    "roomType": {
      "type": "string",
      "enum": ["Cave", "Dungeon", "House", "Overworld", "Special"]
    },
    "dungeonId": {
      "description": "Vanilla dungeon identity, distinct from the logical room id. This is the raw even ID, not a divided table index.",
      "type": "integer",
      "minimum": 0,
      "maximum": 26,
      "multipleOf": 2
    },
    "note": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detailNote": {
      "$ref": "z3-note.schema.json#/definitions/detailNote"
    },
    "position": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 7
      },
      "minItems": 2,
      "maxItems": 2
    },
    "size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "edgeVariants": {
      "type": "object",
      "description": "Required variants for every edge of an overworld room, shared by Light World and Dark World. World-specific differences use a single specialized variant. See docs/edge-variants.md.",
      "required": ["north", "south", "east", "west"],
      "additionalProperties": false,
      "properties": {
        "north": {
          "$ref": "#/definitions/edgeVariantSegments"
        },
        "south": {
          "$ref": "#/definitions/edgeVariantSegments"
        },
        "east": {
          "$ref": "#/definitions/edgeVariantSegments"
        },
        "west": {
          "$ref": "#/definitions/edgeVariantSegments"
        }
      }
    },
    "enemySpawns": {
      "$ref": "z3-room-enemies.schema.json"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "spawnPoint": {
            "type": "string",
            "description": "Regular restart destination identity; availability and selection follow docs/respawn-points.md. Visiting this node does not unlock it. Pyramid restarts in the Dark World.",
            "enum": ["house", "sanctuary", "mountainCave", "pyramid"]
          },
          "rememberedSpawnPoint": {
            "type": "string",
            "description": "Remembered checkpoint destination identity, not a trigger. Only one checkpoint is remembered; see docs/respawn-points.md for setting events and restart rules.",
            "enum": ["house", "uncle", "zeldaPrison", "throneRoom", "oldManCave", "sanctuary"]
          },
          "subArea": {
            "type": "string"
          },
          "nodeType": {
            "type": "string",
            "enum": [
              "door",
              "drop",
              "junction",
              "pre-boss",
              "boss",
              "event",
              "fortune",
              "minigame",
              "shop"
            ]
          },
          "world": {
            "type": "string",
            "enum": ["light", "dark", "both"]
          },
          "mirrorPoint": {
            "type": "boolean",
            "default": true,
            "description": "Whether a node present in both worlds permits the implicit Dark World to Light World Magic Mirror strat."
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["edge", "span"],
              "additionalProperties": false,
              "properties": {
                "edge": {
                  "type": "string",
                  "enum": ["north", "south", "east", "west"]
                },
                "span": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "terrain": {
                  "type": "string"
                },
                "world": {
                  "type": "string",
                  "enum": ["light", "dark"]
                }
              }
            }
          },
          "entrances": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "world"],
              "additionalProperties": false,
              "properties": {
                "romEntranceId": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255,
                  "description": "Native ROM entrance record ID for an ordinary door or drop. Omitted for special overworld transitions; multiple entrances may share a record."
                },
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "world": {
                  "type": "string",
                  "enum": ["light", "dark"]
                }
              }
            }
          },
          "whirlpools": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "world"],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "world": {
                  "type": "string",
                  "enum": ["light", "dark"]
                }
              }
            }
          },
          "fluteLocation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "teleports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "world"],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "world": {
                  "type": "string",
                  "enum": ["light", "dark"]
                }
              }
            }
          },
          "killExitNode": {
            "type": "integer",
            "minimum": 1
          },
          "note": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detailNote": {
            "$ref": "z3-note.schema.json#/definitions/detailNote"
          },
          "devNote": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "locationName", "itemLocation", "item"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "subArea": {
            "type": "string"
          },
          "locationName": {
            "type": "string"
          },
          "itemLocation": {
            "type": "integer",
            "minimum": 1
          },
          "world": {
            "type": "string",
            "enum": ["light", "dark"]
          },
          "item": {
            "type": "string"
          },
          "secondaryItem": {
            "description": "Informational alternate vanilla item, usually received when the primary item is already owned. Exceptions are described in devNote.",
            "type": "string"
          },
          "itemAddress": {
            "description": "Optional hexadecimal string giving the unheadered ROM file offset of the location-specific item receipt-ID byte. Omitted when the location has no independent item receipt-ID byte.",
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]+$"
          },
          "devNote": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "lockedDoors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "locationName", "doorPosition", "doorLocation", "keyType"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "subArea": {
            "type": "string"
          },
          "locationName": {
            "type": "string"
          },
          "world": {
            "type": "string",
            "enum": ["light", "dark"]
          },
          "doorPosition": {
            "type": "string",
            "enum": ["north", "south", "east", "west", "middle"]
          },
          "doorLocation": {
            "type": "integer",
            "minimum": 1
          },
          "keyType": {
            "type": "string",
            "enum": ["big", "small", "bomb", "bomb, boots", "boots", "glove"]
          },
          "devNote": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "note"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "note": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detailNote": {
            "$ref": "z3-note.schema.json#/definitions/detailNote"
          }
        }
      }
    },
    "strats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["link", "name", "requires"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "Stable identifier unique among strats in this room. Missing IDs are assigned by scripts/populate_strat_ids.py."
          },
          "link": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "name": {
            "type": "string"
          },
          "world": {
            "type": "string",
            "enum": ["light", "dark", "any"]
          },
          "fromWorld": {
            "type": "string",
            "enum": ["light", "dark"]
          },
          "toWorld": {
            "type": "string",
            "enum": ["light", "dark"]
          },
          "entranceState": {
            "$ref": "#/definitions/entranceState"
          },
          "requires": {
            "type": "array",
            "items": {
              "$ref": "z3-requirement.schema.json"
            }
          },
          "isBunny": {
            "type": "string",
            "enum": ["yes", "no", "any"]
          },
          "setsFlags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "collectsItems": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "grantsItems": {
            "description": "Item receipts granted after the requirements succeed. Repeatable; does not collect a room-local item location.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "clearsObstacles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "resetsObstacles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "unlocksDoor": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "setsFollower": {
            "type": "string",
            "enum": ["None", "Zelda", "Old Man", "Blind", "Dwarf", "Purple Chest", "Super Bomb"]
          },
          "followerComplete": {
            "type": "string",
            "enum": ["Zelda", "Old Man", "Blind", "Dwarf", "Purple Chest", "Super Bomb"]
          },
          "exitState": {
            "$ref": "#/definitions/exitState"
          },
          "note": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detailNote": {
            "$ref": "z3-note.schema.json#/definitions/detailNote"
          },
          "devNote": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notables": {
      "type": "array",
      "description": "Room-specific techniques that consumers can enable individually. Strats reference these by name with a notable requirement.",
      "items": {
        "type": "object",
        "required": ["id", "name", "note"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "Stable identifier unique among notables in this room."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detailNote": {
            "$ref": "z3-note.schema.json#/definitions/detailNote"
          },
          "devNote": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "nextNotableId": {
      "type": "integer",
      "minimum": 1,
      "description": "Next notable ID to assign in this room; must be greater than all existing notable IDs."
    },
    "nextStratId": {
      "type": "integer",
      "minimum": 1,
      "description": "Next strat ID to assign in this room; must be greater than all existing strat IDs."
    }
  },
  "definitions": {
    "entranceState": {
      "type": "object",
      "description": "A temporary state received on entering through the strat's from node. Exactly one property names the state.",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/definitions/eventState"
        },
        "overhead": {
          "$ref": "#/definitions/overheadState"
        }
      }
    },
    "exitState": {
      "type": "object",
      "description": "A temporary state carried, or a forced transition, on leaving through the strat's to node. Exactly one property names the state.",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/definitions/eventState"
        },
        "overhead": {
          "$ref": "#/definitions/overheadState"
        },
        "leaveNormally": {
          "$ref": "#/definitions/leaveNormallyState"
        }
      }
    },
    "leaveNormallyState": {
      "type": "object",
      "description": "Forces an immediate normal overworld screen transition at the strat's destination node, as determined by the selected edgeVariants. No matching entranceState is required.",
      "additionalProperties": false,
      "properties": {}
    },
    "eventState": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "entranceID": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string"
        }
      }
    },
    "overheadState": {
      "type": "object",
      "description": "An object held overhead across an overworld screen edge. The strat endpoint node identifies the transition; no entranceID is used.",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["class1", "class3"],
          "description": "Thrown-object damage class, matched exactly."
        }
      }
    },
    "edgeVariantName": {
      "type": "string",
      "enum": [
        "closed",
        "wide",
        "dual-small",
        "dual-upper",
        "small-1",
        "small-2",
        "light-only",
        "land-water-land",
        "vertical-water-land",
        "horizonal-water-land",
        "horizontal-land-water",
        "split-house",
        "lake",
        "light-and-mirror"
      ],
      "description": "Allowed edge variant names from the Variant Types section of docs/edge-variants.md."
    },
    "edgeVariantSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "default"],
      "properties": {
        "supported": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "propertyNames": {
            "$ref": "#/definitions/edgeVariantName"
          },
          "properties": {
            "closed": {
              "type": "array",
              "minItems": 0,
              "maxItems": 0,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "wide": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "dual-small": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "dual-upper": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "small-1": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "small-2": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "light-only": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "land-water-land": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "vertical-water-land": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "horizonal-water-land": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "horizontal-land-water": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "split-house": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "lake": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": [
                {"type": "integer", "minimum": 1},
                {"anyOf": [
                  {"type": "integer", "minimum": 1},
                  {"const": "return"}
                ]}
              ]
            },
            "light-and-mirror": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": ["integer", "null"],
                "minimum": 1
              },
              "description": "By role: ordinary Light World endpoint, Dark World Mirror source, Light World unreachable destination except through a transition after mirroring."
            }
          },
          "description": "Variant names map to ordered local node IDs: map order except for role-based variants such as light-and-mirror."
        },
        "default": {
          "$ref": "#/definitions/edgeVariantName"
        }
      },
      "description": "Any supported choice can be combined with choices on other segments. default must belong to supported and is the option closest to vanilla; this membership rule requires semantic validation."
    },
    "edgeVariantSegments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/definitions/edgeVariantSegment"
      },
      "description": "One segment per two screens: west to east on north/south edges, north to south on east/west edges. Length must match the corresponding room dimension divided by two; this requires semantic validation."
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["notables"]
      },
      "then": {
        "required": ["nextNotableId"]
      }
    },
    {
      "if": {
        "required": ["edgeVariants"]
      },
      "then": {
        "required": ["size"],
        "properties": {
          "roomType": {
            "const": "Overworld"
          },
          "size": {
            "items": {
              "enum": [2, 4]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["roomType"],
        "properties": {
          "roomType": {
            "const": "Overworld"
          }
        }
      },
      "then": {
        "required": ["edgeVariants", "darkWorldName"],
        "properties": {
          "nodes": {
            "items": {
              "required": ["world"]
            }
          },
          "strats": {
            "items": {
              "allOf": [
                {
                  "if": {
                    "anyOf": [
                      {
                        "required": ["exitState"],
                        "properties": {
                          "exitState": {
                            "required": ["overhead"]
                          }
                        }
                      },
                      {
                        "required": ["entranceState"],
                        "properties": {
                          "entranceState": {
                            "required": ["overhead"]
                          }
                        }
                      }
                    ]
                  },
                  "then": {
                    "required": ["world"]
                  }
                },
                {"oneOf": [
                  {"required": ["world"]},
                  {"required": ["fromWorld", "toWorld"]}
                ]},
                {"properties": {
                  "exitState": {
                    "properties": {
                      "event": {
                        "required": ["entranceID"]
                      }
                    }
                  },
                  "entranceState": {
                    "properties": {
                      "event": {
                        "required": ["entranceID"]
                      }
                    }
                  }
                }}
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "darkWorldName": false,
          "strats": {
            "items": {
              "properties": {
                "exitState": {
                  "required": ["event"]
                },
                "entranceState": {
                  "required": ["event"]
                }
              }
            }
          },
          "nodes": {
            "items": {
              "required": ["nodeType"]
            }
          }
        }
      }
    }
  ]
}
