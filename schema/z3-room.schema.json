{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "z3-room.schema.json",
  "type": "object",
  "description": "An object that describes one contiguous area without transitions in Link to the Past",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Identifier for this room, unique across the entire game",
      "default": 0,
      "examples": [
        7
      ]
    },
    "name": {
      "type": "string",
      "description": "A name for the room. Must be unique.",
      "default": "",
      "examples": [
        "Link's House"
      ],
      "pattern": "^(.*)$"
    },
    "note": {
      "type": "string",
      "default": "",
      "pattern": "^(.*)$"
    },
    "alttpEntrandoRegions": {
      "type": "array",
      "description": "The name of all regions (as defined in the ALttP Entrando project) that are (at least partially) contained in this room.",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "description": "Doors, transitions, item locations, and other points of interest within this room.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "nodeType"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identifier for this node, unique within the room.",
            "default": 0,
            "examples": [
              1
            ]
          },
          "name": {
            "type": "string",
            "description": "Name of this node. Must be unique across all rooms.",
            "default": "",
            "examples": [
              "Exit"
            ],
            "pattern": "^(.*)$"
          },
          "nodeType": {
            "type": "string",
            "description": "Examples: door, elevator, event, eye, gray, green, item, vertical",
            "default": "",
            "examples": [
              "door",
              "drop",
              "entrance",
              "exit",
              "event",
              "item"
            ],
            "enum": [
              "door",
              "drop",
              "entrance",
              "exit",
              "event",
              "item",
              "junction",
              "obstacle",
              "transition"
            ],
            "pattern": "^(.*)$"
          },
          "nodeItem": {
            "type": "string",
            "description": "Item that normally resides at this node in Vanilla"
          },
          "nodeAddress": {
            "type": [
              "string",
              "array"
            ],
            "description": "Memory address of this location"
          },
          "requires": {
            "type": [
              "array",
              "null"
            ],
            "description": "Equipment, tech, and flag requirements to reach this node within Room. Array elements are ANDed together.",
            "items": {
              "type": [
                "object",
                "string"
              ]
            }
          },
          "locks": {
            "type": [
              "array",
              "null"
            ],
            "description": "An array of corresponding lock and unlock conditions for this node",
            "default": null,
            "items": {
              "type": "object",
              "description": "Contains corresponding lock and unlock conditions for a node. If lock condition is missing, the lock is initially active.",
              "required": [
                "lockType",
                "unlock"
              ],
              "properties": {
                "lockType": {
                  "type": "string",
                  "default": "",
                  "enum": [
                    "bossFight",
                    "lockedDoor",
                    "cutscene",
                    "gameFlag",
                    "killEnemies",
                    "permanent",
                    "triggeredEvent"
                  ],
                  "pattern": "^(.*)$"
                },
                "lock": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "description": "Equipment, tech, and flag requirements for this node to be locked"
                },
                "unlock": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "description": "Equipment, tech, and flag requirements to deactivate the associated lock"
                },
                "note": {
                  "type": "string",
                  "default": "",
                  "pattern": "^(.*)$"
                }
              }
            }
          },
          "view": {
            "type": [
              "array",
              "null"
            ],
            "description": "Equipment, tech, and flag requirements to view this node within Room. Array elements are ANDed together.",
            "items": {
              "type": [
                "object",
                "string"
              ]
            }
          },
          "yields": {
            "type": "array",
            "description": "Abilities or flags granted by this node."
          },
          "note": {
            "type": "string",
            "default": "",
            "examples": [
              "Door Object"
            ],
            "pattern": "^(.*)$"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "description": "Pathways between nodes within the room.",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "description": "ID of the node within this room where the link originates.",
            "default": 0,
            "examples": [
              1
            ]
          },
          "to": {
            "type": [
              "array",
              "null"
            ],
            "description": "Possible destination nodes for this link within the room.",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "oneOf": [
                {
                  "required": [
                    "requires"
                  ]
                },
                {
                  "required": [
                    "strats"
                  ]
                }
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "ID of the destination node within this room.",
                  "default": 0,
                  "examples": [
                    2
                  ]
                },
                "requires": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "description": "Equipment, tech, and flag requirements to traverse this Link. Array elements are ANDed together.",
                  "items": {
                    "type": [
                      "object",
                      "string"
                    ]
                  }
                },
                "strats": {
                  "type": "array",
                  "description": "An array of strats that can be used to cross the link.",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "notable",
                      "requires"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "A name for the strat",
                        "default": "",
                        "examples": [
                          "Base",
                          "Ice Palace Bomb Jump"
                        ],
                        "pattern": "^(.*)$"
                      },
                      "notable": {
                        "type": "boolean"
                      },
                      "requires": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "description": "Equipment, tech, and flag requirements to execute this strat. Array elements are ANDed together.",
                        "items": {
                          "type": [
                            "object",
                            "string"
                          ]
                        }
                      }
                    }
                  }
                },
                "note": {
                  "type": "string",
                  "default": "",
                  "pattern": "^(.*)$"
                }
              }
            }
          }
        }
      }
    }
  }
}
