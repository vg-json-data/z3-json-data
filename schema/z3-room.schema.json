{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "z3-room.schema.json",
  "type": "object",
  "description": "A contiguous area in Link to the Past.",
  "required": [
    "id",
    "name",
    "roomType",
    "nodes",
    "strats"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "type": "string"
    },
    "roomType": {
      "type": "string",
      "enum": [
        "Cave",
        "Dungeon",
        "House",
        "Overworld",
        "Special"
      ]
    },
    "note": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detailNote": {"$ref": "z3-note.schema.json#/definitions/detailNote"},
    "position": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 7
      },
      "minItems": 2,
      "maxItems": 2
    },
    "size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "edgeVariants": {
      "type": "object",
      "description": "Required variants for every edge of an overworld room, shared by Light World and Dark World. World-specific differences use a single specialized variant. See docs/edge-variants.md.",
      "required": ["north", "south", "east", "west"],
      "additionalProperties": false,
      "properties": {
        "north": { "$ref": "#/definitions/edgeVariantSegments" },
        "south": { "$ref": "#/definitions/edgeVariantSegments" },
        "east": { "$ref": "#/definitions/edgeVariantSegments" },
        "west": { "$ref": "#/definitions/edgeVariantSegments" }
      }
    },
    "enemySpawns": {
      "anyOf": [
        {"$ref": "z3-overworld-enemies.schema.json"},
        {"$ref": "z3-overworld-enemies.schema.json#/definitions/population"},
        {"$ref": "#/definitions/dungeonEnemies"}
      ],
      "description": "Vanilla enemies and hazards. Dungeons use unique names without counts; caves and houses use placement counts; overworld rooms use world/story profiles."
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "nodeType": {
            "type": "string",
            "enum": [
              "door",
              "drop",
              "junction",
              "pre-boss",
              "boss",
              "event",
              "fortune",
              "minigame",
              "shop"
            ]
          },
          "spawnPoint": {
            "type": "string",
            "description": "Regular restart destination identity; availability and selection follow docs/respawn-points.md. Visiting this node does not unlock it. Pyramid restarts in the Dark World.",
            "enum": ["house", "sanctuary", "mountainCave", "pyramid"]
          },
          "rememberedSpawnPoint": {
            "type": "string",
            "description": "Remembered checkpoint destination identity, not a trigger. Only one checkpoint is remembered; see docs/respawn-points.md for setting events and restart rules.",
            "enum": ["house", "uncle", "zeldaPrison", "throneRoom", "oldManCave", "sanctuary"]
          },
          "subArea": {
            "type": "string"
          },
          "world": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "both"
            ]
          },
          "entrances": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "world"
              ],
              "additionalProperties": false,
              "properties": {
                "romEntranceId": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255,
                  "description": "Native ROM entrance record ID for an ordinary door or drop. Omitted for special overworld transitions; multiple entrances may share a record."
                },
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "world": {
                  "type": "string",
                  "enum": [
                    "light",
                    "dark"
                  ]
                }
              }
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "edge",
                "span"
              ],
              "additionalProperties": false,
              "properties": {
                "edge": {
                  "type": "string",
                  "enum": [
                    "north",
                    "south",
                    "east",
                    "west"
                  ]
                },
                "span": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "terrain": {
                  "type": "string"
                },
                "world": {
                  "type": "string",
                  "enum": [
                    "light",
                    "dark"
                  ]
                }
              }
            }
          },
          "whirlpools": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "world"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "world": {
                  "type": "string",
                  "enum": [
                    "light",
                    "dark"
                  ]
                }
              }
            }
          },
          "fluteLocation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "teleports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "world"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "world": {
                  "type": "string",
                  "enum": [
                    "light",
                    "dark"
                  ]
                }
              }
            }
          },
          "killExitNode": {
            "type": "integer",
            "minimum": 1
          },
          "note": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detailNote": {"$ref": "z3-note.schema.json#/definitions/detailNote"},
          "devNote": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "locationName",
          "itemLocation",
          "item",
          "itemAddress"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "locationName": {
            "type": "string"
          },
          "itemLocation": {
            "type": "integer",
            "minimum": 1
          },
          "item": {
            "type": "string"
          },
          "secondaryItem": {
            "description": "Informational alternate vanilla item, usually received when the primary item is already owned. Exceptions are described in devNote.",
            "type": "string"
          },
          "itemAddress": {
            "type": [
              "string",
              "array"
            ],
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "subArea": {
            "type": "string"
          },
          "world": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          },
          "devNote": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "lockedDoors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "locationName",
          "doorPosition",
          "doorLocation",
          "keyType"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "locationName": {
            "type": "string"
          },
          "doorPosition": {
            "type": "string",
            "enum": [
              "north",
              "south",
              "east",
              "west",
              "middle"
            ]
          },
          "doorLocation": {
            "type": "integer",
            "minimum": 1
          },
          "keyType": {
            "type": "string",
            "enum": [
              "big",
              "small",
              "bomb",
              "bomb, boots",
              "boots",
              "glove"
            ]
          },
          "subArea": {
            "type": "string"
          },
          "world": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          },
          "devNote": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "note": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detailNote": {"$ref": "z3-note.schema.json#/definitions/detailNote"}
        }
      }
    },
    "strats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "link",
          "name",
          "requires"
        ],
        "additionalProperties": false,
        "properties": {
          "link": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "name": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "$ref": "z3-requirement.schema.json"
            }
          },
          "collectsItems": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "grantsItems": {
            "description": "Item receipts granted after the requirements succeed. Repeatable; does not collect a room-local item location.",
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "setsFlags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "clearsObstacles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "resetsObstacles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "unlocksDoor": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "world": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "any"
            ]
          },
          "fromWorld": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          },
          "toWorld": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          },
          "isBunny": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "any"
            ]
          },
          "setsFollower": {
            "type": "string",
            "enum": [
              "None",
              "Zelda",
              "Old Man",
              "Blind",
              "Dwarf",
              "Purple Chest",
              "Super Bomb"
            ]
          },
          "followerComplete": {
            "type": "string",
            "enum": [
              "Zelda",
              "Old Man",
              "Blind",
              "Dwarf",
              "Purple Chest",
              "Super Bomb"
            ]
          },
          "exitState": {
            "type": "object",
            "required": [
              "state",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "event"
                ]
              },
              "entranceID": {
                "type": "integer",
                "minimum": 1
              },
              "type": {
                "type": "string"
              }
            }
          },
          "entranceState": {
            "type": "object",
            "required": [
              "state",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "event"
                ]
              },
              "entranceID": {
                "type": "integer",
                "minimum": 1
              },
              "type": {
                "type": "string"
              }
            }
          },
          "note": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detailNote": {"$ref": "z3-note.schema.json#/definitions/detailNote"},
          "devNote": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notables": {
      "type": "array",
      "description": "Room-specific techniques that consumers can enable individually. Strats reference these by name with a notable requirement.",
      "items": {
        "type": "object",
        "required": ["id", "name", "note"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "Stable identifier unique among notables in this room."
          },
          "name": {"type": "string", "minLength": 1},
          "note": {"type": "array", "items": {"type": "string"}},
          "detailNote": {"$ref": "z3-note.schema.json#/definitions/detailNote"},
          "devNote": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "nextNotableId": {
      "type": "integer",
      "minimum": 1,
      "description": "Next notable ID to assign in this room; must be greater than all existing notable IDs."
    }
  },
  "definitions": {
    "dungeonEnemies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enemies"],
      "properties": {
        "enemies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "description": "Unique enemy, boss, and sprite-hazard names present in the dungeon; no counts."
        }
      }
    },
    "edgeVariantName": {
      "type": "string",
      "enum": [
        "closed",
        "wide",
        "dual-small",
        "small-1",
        "small-2",
        "light-only",
        "land-water-land",
        "vertical-water-land",
        "horizonal-water-land",
        "horizontal-land-water",
        "split-house",
        "lake",
        "light-and-mirror"
      ],
      "description": "Allowed edge variant names from the Variant Types section of docs/edge-variants.md."
    },
    "edgeVariantSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "default"],
      "properties": {
        "supported": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "propertyNames": {
            "$ref": "#/definitions/edgeVariantName"
          },
          "properties": {
            "closed": {
              "type": "array",
              "minItems": 0,
              "maxItems": 0,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "wide": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "dual-small": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "small-1": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "small-2": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "light-only": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "land-water-land": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "vertical-water-land": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "horizonal-water-land": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "horizontal-land-water": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "split-house": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "lake": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": [
                { "type": "integer", "minimum": 1 },
                {
                  "anyOf": [
                    { "type": "integer", "minimum": 1 },
                    { "const": "return" }
                  ]
                }
              ]
            },
            "light-and-mirror": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": ["integer", "null"],
                "minimum": 1
              },
              "description": "By role: ordinary Light World endpoint, Dark World Mirror source, Light World unreachable destination except through a transition after mirroring."
            }
          },
          "description": "Variant names map to ordered local node IDs: map order except for role-based variants such as light-and-mirror."
        },
        "default": {
          "$ref": "#/definitions/edgeVariantName"
        }
      },
      "description": "Any supported choice can be combined with choices on other segments. default must belong to supported and is the option closest to vanilla; this membership rule requires semantic validation."
    },
    "edgeVariantSegments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/definitions/edgeVariantSegment" },
      "description": "One segment per two screens: west to east on north/south edges, north to south on east/west edges. Length must match the corresponding room dimension divided by two; this requires semantic validation."
    }
  },
  "allOf": [
    {
      "if": {"required": ["notables"]},
      "then": {"required": ["nextNotableId"]}
    },
    {
      "if": {"properties": {"roomType": {"const": "Dungeon"}}},
      "then": {"properties": {"enemySpawns": {"$ref": "#/definitions/dungeonEnemies"}}},
      "else": {"properties": {"enemySpawns": {"oneOf": [
        {"$ref": "z3-overworld-enemies.schema.json"},
        {"$ref": "z3-overworld-enemies.schema.json#/definitions/population"}
      ]}}}
    },
    {
      "if": { "required": ["edgeVariants"] },
      "then": {
        "required": ["size"],
        "properties": {
          "roomType": { "const": "Overworld" },
          "size": { "items": { "enum": [2, 4] } }
        }
      }
    },
    {
      "if": {
        "required": [
          "roomType"
        ],
        "properties": {
          "roomType": {
            "const": "Overworld"
          }
        }
      },
      "then": {
        "required": ["edgeVariants"],
        "properties": {
          "nodes": {
            "items": {
              "required": [
                "world"
              ]
            }
          },
          "strats": {
            "items": {
              "allOf": [
                {
                  "oneOf": [
                    {
                      "required": [
                        "world"
                      ]
                    },
                    {
                      "required": [
                        "fromWorld",
                        "toWorld"
                      ]
                    }
                  ]
                },
                {
                  "if": {
                    "required": [
                      "exitState"
                    ]
                  },
                  "then": {
                    "properties": {
                      "exitState": {
                        "required": [
                          "entranceID"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "entranceState"
                    ]
                  },
                  "then": {
                    "properties": {
                      "entranceState": {
                        "required": [
                          "entranceID"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "nodes": {
            "items": {
              "required": [
                "nodeType"
              ]
            }
          }
        }
      }
    }
  ]
}
