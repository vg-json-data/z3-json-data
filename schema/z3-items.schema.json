{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "z3-items.schema.json",
  "type": "object",
  "description": "Items, item receipts, dungeon prizes, goal items, and flags used by Link to the Past logic.",
  "required": [
    "inventory",
    "refills",
    "bottleContents",
    "currency",
    "dungeonItems",
    "dungeonPrizes",
    "healthUpgrades",
    "flags"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "inventory": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "detailNote": {
          "$ref": "z3-note.schema.json#/definitions/detailNote"
        },
        "items": {
          "$ref": "#/definitions/itemReceiptList"
        }
      }
    },
    "refills": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "detailNote": {
          "$ref": "z3-note.schema.json#/definitions/detailNote"
        },
        "items": {
          "$ref": "#/definitions/itemReceiptList"
        }
      }
    },
    "bottleContents": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "detailNote": {
          "$ref": "z3-note.schema.json#/definitions/detailNote"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/bottleContent"
          }
        }
      }
    },
    "currency": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "detailNote": {
          "$ref": "z3-note.schema.json#/definitions/detailNote"
        },
        "items": {
          "$ref": "#/definitions/itemReceiptList"
        }
      }
    },
    "dungeonItems": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "detailNote": {
          "$ref": "z3-note.schema.json#/definitions/detailNote"
        },
        "items": {
          "$ref": "#/definitions/itemReceiptList"
        }
      }
    },
    "dungeonPrizes": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "detailNote": {
          "$ref": "z3-note.schema.json#/definitions/detailNote"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/dungeonPrize"
          }
        }
      }
    },
    "healthUpgrades": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "detailNote": {
          "$ref": "z3-note.schema.json#/definitions/detailNote"
        },
        "items": {
          "$ref": "#/definitions/itemReceiptList"
        }
      }
    },
    "flags": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "detailNote": {
          "$ref": "z3-note.schema.json#/definitions/detailNote"
        },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/name"
          }
        }
      }
    },
    "nonVanilla": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "detailNote": {
          "$ref": "z3-note.schema.json#/definitions/detailNote"
        },
        "items": {
          "$ref": "#/definitions/itemReceiptList"
        }
      }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "byte": {
      "type": "string",
      "pattern": "^0x[0-9A-F]{2}$"
    },
    "itemReceiptList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/itemReceipt"
      }
    },
    "itemReceipt": {
      "type": "object",
      "required": [
        "name",
        "itemReceiptId"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/definitions/name"
        },
        "itemReceiptId": {
          "$ref": "#/definitions/byte"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "detailNote": {
          "$ref": "z3-note.schema.json#/definitions/detailNote"
        }
      }
    },
    "bottleContent": {
      "type": "object",
      "required": [
        "name",
        "itemReceiptId"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/definitions/name"
        },
        "itemReceiptId": {
          "$ref": "#/definitions/byte"
        },
        "refillReceiptId": {
          "$ref": "#/definitions/byte"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "detailNote": {
          "$ref": "z3-note.schema.json#/definitions/detailNote"
        }
      }
    },
    "dungeonPrize": {
      "type": "object",
      "required": [
        "name",
        "itemReceiptId",
        "prizePatchBytes"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/definitions/name"
        },
        "itemReceiptId": {
          "$ref": "#/definitions/byte"
        },
        "prizePatchBytes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/definitions/byte"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "detailNote": {
          "$ref": "z3-note.schema.json#/definitions/detailNote"
        }
      }
    }
  }
}
