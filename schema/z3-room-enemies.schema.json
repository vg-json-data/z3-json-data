{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "z3-room-enemies.schema.json",
  "type": "object",
  "description": "Vanilla enemies and hazards in a room. Overworld rooms use world/story profiles; other rooms use one enemies list.",
  "additionalProperties": false,
  "properties": {
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeZeldaRescue", "afterZeldaRescue", "afterAgahnim"],
      "properties": {
        "beforeZeldaRescue": {
          "$ref": "#/definitions/population"
        },
        "afterZeldaRescue": {
          "$ref": "#/definitions/population"
        },
        "afterAgahnim": {
          "$ref": "#/definitions/population"
        }
      }
    },
    "dark": {
      "$ref": "#/definitions/population"
    },
    "enemies": {
      "$ref": "#/definitions/enemies"
    }
  },
  "definitions": {
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enemies"],
      "properties": {
        "enemies": {
          "$ref": "#/definitions/enemies"
        }
      }
    },
    "enemies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "count": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "Number of placements, or null for recurring spawns with no fixed count. Omitted in dungeons, which list unique names."
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "detailNote": {
            "$ref": "z3-note.schema.json#/definitions/detailNote"
          }
        },
        "if": {
          "properties": {
            "name": {
              "type": "null"
            }
          }
        },
        "then": {
          "required": ["note"]
        }
      }
    }
  }
}
